rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Global default-deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper primitives
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // Validation for UserProfile
    function isValidUserProfile(data, userId) {
      return data.keys().hasAll(['uid', 'email'])
        && data.keys().hasOnly(['uid', 'displayName', 'email', 'photoURL', 'role', 'createdAt', 'updatedAt'])
        && data.uid == userId
        && data.email is string && data.email.size() <= 200
        && (!('displayName' in data) || (data.displayName is string && data.displayName.size() <= 200))
        && (!('photoURL' in data) || (data.photoURL is string && data.photoURL.size() <= 500))
        && (!('role' in data) || (data.role is string && data.role.size() <= 50));
    }

    // Validation for SavedWorksheet
    function isValidSavedWorksheet(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'title', 'worksheetData'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'grade', 'chapter', 'worksheetData', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.id is string && isValidId(data.id)
        && data.title is string && data.title.size() <= 255
        && data.worksheetData is string
        && (!('grade' in data) || (data.grade is string && data.grade.size() <= 100))
        && (!('chapter' in data) || (data.chapter is string && data.chapter.size() <= 255));
    }

    // Validation for ChatSession
    function isValidChatSession(data, userId) {
      return data.keys().hasAll(['id', 'userId', 'messages'])
        && data.keys().hasOnly(['id', 'userId', 'title', 'messages', 'modelUsed', 'createdAt', 'updatedAt'])
        && data.userId == userId
        && data.id is string && isValidId(data.id)
        && data.messages is string
        && (!('title' in data) || (data.title is string && data.title.size() <= 255))
        && (!('modelUsed' in data) || (data.modelUsed is string && data.modelUsed.size() <= 100));
    }

    // Connection health check doc
    match /test/connection {
      allow read: if true;
    }

    // User profile doc
    match /users/{userId} {
      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId);
      allow update: if isOwner(userId) && isValidId(userId) && isValidUserProfile(incoming(), userId)
        && incoming().uid == existing().uid;
      allow delete: if isOwner(userId) && isValidId(userId);

      // User's saved worksheets subcollection
      match /worksheets/{worksheetId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(worksheetId)
          && isValidSavedWorksheet(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(worksheetId)
          && isValidSavedWorksheet(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(worksheetId);
      }

      // User's chat sessions subcollection
      match /chats/{chatId} {
        allow get, list: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidId(chatId)
          && isValidChatSession(incoming(), userId);
        allow update: if isOwner(userId) && isValidId(userId) && isValidId(chatId)
          && isValidChatSession(incoming(), userId)
          && incoming().userId == existing().userId
          && incoming().id == existing().id;
        allow delete: if isOwner(userId) && isValidId(userId) && isValidId(chatId);
      }
    }
  }
}
